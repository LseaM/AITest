{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "spec_id",
    "version",
    "title",
    "status",
    "source_files",
    "reviewer",
    "reviewed_at"
  ],
  "properties": {
    "spec_id": {
      "type": "string",
      "pattern": "^SPEC_[A-Z0-9_]{3,}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "needs_clarification", "approved"]
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sources/.+"
      }
    },
    "reviewer": {
      "type": ["string", "null"]
    },
    "reviewed_at": {
      "type": ["string", "null"],
      "format": "date"
    }
  },
  "additionalProperties": false
}
